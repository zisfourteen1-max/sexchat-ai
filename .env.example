# Copy this file to .env and fill in your own values. Never commit .env.
# Any OpenAI-compatible API works: OpenAI, Groq, OpenRouter, Together, or a local Ollama server.

# Required: your LLM API key
OPENAI_API_KEY=

# Base URL of the LLM API (change for other providers)
# OpenAI: https://api.openai.com/v1
# Groq: https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
# Ollama (local): http://localhost:11434/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Model name for your provider, e.g. gpt-4o-mini, llama-3.1-8b-instant, mistralai/mistral-7b-instruct
MODEL=gpt-4o-mini

# Port the app listens on
PORT=3000
